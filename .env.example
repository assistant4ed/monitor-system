# Upstash Redis (get from Vercel > Storage > Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# Monitor settings
MONITOR_API_KEY=your-secret-api-key
MONITOR_RETENTION_HOURS=72

# Services to monitor (comma-separated URLs)
MONITOR_SERVICES=https://example.com,https://api.example.com/health
